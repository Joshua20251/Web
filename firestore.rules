rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PRIMITIVES ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'joshua917813@gmail.com' && 
        request.auth.token.email_verified == true
      );
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$'); }

    // --- ENTITY VALIDATION ---
    function isValidFeedback(data) {
      return data.keys().hasAll(['content', 'atmosphere', 'issue', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
             data.atmosphere is string && data.atmosphere.size() >= 1 && data.atmosphere.size() <= 500 &&
             data.issue is string && data.issue.size() >= 1 && data.issue.size() <= 1000 &&
             data.createdAt == request.time;
    }

    function isValidSurvey(data) {
      return data.keys().hasAll(['gender', 'grade', 'playFrequency', 'timeSlots', 'neutralRating', 'barriers', 'additionalFeedback', 'createdAt']) &&
             data.keys().size() == 8 &&
             data.gender is string && data.gender.size() >= 1 && data.gender.size() <= 100 &&
             data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 100 &&
             data.playFrequency is string && data.playFrequency.size() >= 1 && data.playFrequency.size() <= 100 &&
             data.timeSlots is list &&
             data.neutralRating is number && data.neutralRating >= 1 && data.neutralRating <= 5 &&
             data.barriers is list &&
             data.additionalFeedback is string && data.additionalFeedback.size() <= 2000 &&
             data.createdAt == request.time;
    }

    // --- MATCH BLOCKS ---
    match /feedbacks/{feedbackId} {
      allow create: if isValidFeedback(incoming());
      allow get, list: if isAdmin();
      // No updates or deletes allowed for feedback
    }

    match /surveys/{surveyId} {
      allow create: if isValidSurvey(incoming());
      allow get, list: if isAdmin();
      // No updates or deletes allowed for surveys
    }

    // Test connection doc (Validation helper as per skill)
    match /test/connection {
      allow get: if true;
    }
  }
}
