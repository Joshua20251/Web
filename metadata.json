rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Feedback collection
    match /feedbacks/{feedbackId} {
      allow create: if true; // Anyone can submit anonymous feedback
      allow get, list: if request.auth != null; // Only authenticated users (admins) can read
    }
  }
}
